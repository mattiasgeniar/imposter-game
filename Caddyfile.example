# Example Caddy site config for serving the built `dist/` directory.
# Replace `your-domain.example` and `/srv/imposter` with your own values.

your-domain.example {
    encode zstd gzip

    log {
        output file /srv/imposter/logs/access.log
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    root * /srv/imposter/public

    # Vite hashed assets — content-addressed, safe to cache forever
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Entry points + icons — always revalidate via ETag so deploys propagate
    # immediately. Browsers still keep a cached copy and only download fresh
    # bytes when the ETag changes (cheap 304 otherwise).
    @entrypoints path / /index.html /sw.js /manifest.webmanifest /favicon-32.png /apple-touch-icon.png /icon-192.png /icon-512.png /icon-maskable.png
    header @entrypoints Cache-Control "no-cache"

    file_server
}
